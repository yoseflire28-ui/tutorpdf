{
  "context_server_timeout": 60,
  "disable_ai": false,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "left",
    "dock": "right",
    "default_model": {
      "provider": "google",
      "model": "gemini-3.1-flash-lite"
    },
    "favorite_models": [
      {
        "provider": "google",
        "model": "gemini-3.1-flash-lite"
      },
      {
        "provider": "google",
        "model": "gemini-2.5-flash-lite"
      }
    ]
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always"
  },
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  }
}
